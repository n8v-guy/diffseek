{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "../.cache/types/app",
    "rootDir": "..",
    "tsBuildInfoFile": "../.cache/types/app.tsbuildinfo",
    "types": ["node", "wxt/vite-builder-env"]
  },
  "include": ["../src/app/**/*.ts", "../test/e2e/**/*.ts"],
  "references": [
    { "path": "./tsconfig.modules.json" },
    { "path": "./tsconfig.adapters.json" }
  ]
}
