{
  "name": "diffseek",
  "version": "1.0.0",
  "description": "DiffSeek is a subtle GitHub ergonomics facelift for reviewing pull requests. It improves the existing **Files changed** file tree without replacing GitHub's review model.",
  "scripts": {
    "audit:ci": "pnpm audit --prod --audit-level=moderate",
    "build": "wxt build --config config/wxt.config.ts",
    "check:ci": "concurrently --kill-others-on-fail --names quality,build \"pnpm check:ci:quality\" \"pnpm build\"",
    "check:ci:full": "concurrently --kill-others-on-fail --names quality,e2e \"pnpm check:ci:quality\" \"pnpm exec playwright install --with-deps --no-shell chromium && pnpm build && pnpm test:e2e:run\"",
    "check:ci:quality": "concurrently --kill-others-on-fail --names rules,eslint,knip,types,coverage,audit \"pnpm lint:rules\" \"pnpm lint:ci\" \"pnpm lint:knip\" \"pnpm typecheck\" \"pnpm coverage:ci\" \"pnpm audit:ci\"",
    "check:commit": "pnpm lint:staged && pnpm lint:rules",
    "check:push": "pnpm check:ci",
    "coverage:ci": "vitest run --config config/vitest.config.ts --coverage --silent=passed-only",
    "dev": "wxt --config config/wxt.config.ts",
    "lint": "concurrently --kill-others-on-fail \"pnpm lint:rules\" \"pnpm lint:ci\"",
    "lint:ci": "eslint --config config/eslint.config.ts . --no-cache --max-warnings 0",
    "lint:knip": "knip --config config/knip.json --tsConfig config/tsconfig.shared.json",
    "lint:rules": "./scripts/check-structure.ts",
    "lint:staged": "lint-staged --config config/lint-staged.config.ts",
    "postinstall": "wxt prepare --config config/wxt.config.ts",
    "prepare": "husky",
    "release:zip": "wxt zip --config config/wxt.config.ts",
    "test": "vitest --config config/vitest.config.ts",
    "test:ci": "vitest run --config config/vitest.config.ts",
    "test:e2e": "pnpm build && pnpm test:e2e:run",
    "test:e2e:run": "playwright test --config config/playwright.config.ts",
    "typecheck": "tsc --build config/tsconfig.json --pretty false"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "knip": "^6.36.0",
    "lint-staged": "^17.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
